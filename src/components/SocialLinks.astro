---
import { site } from '../config';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['socials', className]}>
  <a href={site.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram de la cofradía">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
      <rect x="3.4" y="3.4" width="17.2" height="17.2" rx="4.8" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r=".9" fill="currentColor" stroke="none" />
    </svg>
  </a>
  <a href={site.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook de la cofradía">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
      <path d="M13.6 21v-7.4h2.5l.4-2.9h-2.9V8.8c0-.8.2-1.4 1.4-1.4h1.6V4.8c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2h-2.5v2.9h2.5V21h3.2Z" />
    </svg>
  </a>
  <a href={`mailto:${site.email}`} aria-label="Enviar un correo a la cofradía">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
      <rect x="3" y="5.5" width="18" height="13" rx="1.5" />
      <path d="m4 7 8 6 8-6" />
    </svg>
  </a>
</div>
