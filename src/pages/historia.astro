  <section class="portal-band">
    <div class="wrap portal-band__inner">
      <div>
        <h2>La historia continúa contigo</h2>
        <p>
          La cofradía sigue creciendo con nuevas generaciones que comparten su fe y su memoria.
        </p>
      </div>
      <a class="btn btn--gold" href="/hazte-hermano">Hazte hermano</a>
